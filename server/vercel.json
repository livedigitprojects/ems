{
  "version": 2,
  "builds": [{ "src": "server.js", "use": "@vercel/node" }],
  "routes": [
    {
      "src": "/(.*)",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "dest": "/server.js"
    }
  ],
  "crons": [
    { "path": "/api/internal/run-birthday-check", "schedule": "30 3 * * *" },
    { "path": "/api/internal/run-auto-checkout",  "schedule": "30 18 * * *" }
  ]
}